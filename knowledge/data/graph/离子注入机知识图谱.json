{
  "nodes": [
    {
      "type": "系统",
      "name": "离子注入机",
      "detail_info": {
        "概述": "集成电路制造前道工序中的关键设备，用于将掺杂元素（如硼B、磷P、砷As等）以离子形式注入到硅晶圆中，从而改变半导体的载流子浓度和导电类型。与常规热掺杂工艺相比，离子注入可实现对注入剂量、注入角度、注入深度和横向扩散的精确控制。主要由离子源系统、质量分析器、加速管、聚焦和扫描系统、工艺腔（靶室）五大部分组成。"
      }
    },
    {
      "type": "子系统",
      "name": "离子源系统",
      "detail_info": {
        "概述": "离子注入机的“心脏”，负责产生并维持等离子体，为后续束流提供离子。离子源系统的稳定运行是获得稳定束流的基础，主要包含灯丝电源系统、弧电源系统（C1）、引出与抑制系统等子单元。"
      }
    },
    {
      "type": "子系统",
      "name": "加速系统",
      "detail_info": {
        "概述": "离子注入机核心子系统之一，通过加速电源为离子提供能量，决定离子最终能量和注入深度，核心参数为加速电源电压/电流，电压典型范围10 keV - 1 MeV，常用20-400 keV，直接影响束流传输效率。"
      }
    },
    {
      "type": "子系统",
      "name": "聚焦系统",
      "detail_info": {
        "概述": "包含C2/C3电源系统，用于束流的预聚焦和精细聚焦，确保束流以最佳形状进入质量分析器，核心部件为聚焦透镜、四极透镜，电压典型范围±1 kV ~ ±10 kV，直接影响束流形状和传输效率。"
      }
    },
    {
      "type": "子系统",
      "name": "对中系统",
      "detail_info": {
        "概述": "用于调整离子束的位置和角度，确保束流精确对准晶圆靶面，对中不良会导致束流损失或注入不均匀。分为X/Y方向偏移和倾斜调节，通过偏转板产生静电场实现束流平移和角度调整，保障注入精度。"
      }
    },
    {
      "type": "子系统",
      "name": "消像散系统",
      "detail_info": {
        "概述": "用于消除束流的像散像差，使束流截面呈圆形而非椭圆形，确保注入均匀性。像散主要由四极透镜的不对称性引起，包含斜向消像散、轴向消像散和微调焦系统，通过线圈电流实现像散校正。"
      }
    },
    {
      "type": "子系统",
      "name": "冷却系统",
      "detail_info": {
        "概述": "为离子注入机的关键部件提供恒温冷却，维持设备稳定运行，温度波动会影响离子源稳定性、束流品质和注入精度。核心监测参数为冷水机压力和内部温度，冷却对象包括离子源、电源模块、真空泵、加速管等。"
      }
    },
    {
      "type": "子系统",
      "name": "工件台系统",
      "detail_info": {
        "概述": "用于承载和移动硅晶圆，通过X/Y轴伺服电机实现晶圆的精确定位和扫描，配合束流实现均匀注入。定位精度±1 μm，分辨率<0.1 μm，移动速度1-100 mm/s（可调），是保障注入均匀性的关键系统。"
      }
    },
    {
      "type": "子系统",
      "name": "灯丝电源系统",
      "detail_info": {
        "概述": "离子源系统核心子单元，为钨灯丝提供加热电源，通过电压和电流共同决定加热功率（P=U×I），控制热电子发射量，直接影响等离子体密度。灯丝电压典型5-20 VDC，电流50-300 A，是离子产生的基础。"
      }
    },
    {
      "type": "子系统",
      "name": "弧电源系统",
      "detail_info": {
        "概述": "又称C1电源系统，离子源系统核心单元，通过弧电压和弧电流控制弧室放电，决定电子能量和电离效率，直接影响离子产生速率。弧电压典型50-150 VDC，弧电流反映等离子体密度和电离强度。"
      }
    },
    {
      "type": "子系统",
      "name": "引出系统",
      "detail_info": {
        "概述": "离子源系统子单元，通过引出电极和高压电源产生电场，将离子源中的等离子体离子引出，决定离子引出效率和初始能量。引出电压典型10-50 kVDC，常用20-40 kV，引出电流与束流强度直接相关。"
      }
    },
    {
      "type": "子系统",
      "name": "抑制系统",
      "detail_info": {
        "概述": "离子源系统子单元，通过抑制电极施加负偏压，防止二次电子回流到离子源，提高束流效率。抑制电压典型-500 VDC ~ -5 kVDC，常用-1 kV ~ -2 kV，抑制电流用于监测二次电子收集情况，反映抑制效果。"
      }
    },
    {
      "type": "监测值",
      "name": "束流强度",
      "detail_info": {
        "定义与意义": "离子注入机最核心的监测指标，表示单位时间内通过束流传输路径的离子电荷量，通常以微安（μA）或毫安（mA）为单位。束流强度直接决定了离子注入的剂量率，是控制掺杂浓度的关键参数。",
        "典型范围": "微流机：1-100 μA；强流机：1-50 mA",
        "测量精度": "±1% FS（满量程）",
        "响应时间": "< 10 ms",
        "测量方式": "法拉第杯 + 积分器",
        "采样频率": "10-1000 Hz（可调）",
        "温度漂移": "< 50 ppm/°C",
        "长期稳定度": "< 0.1% / 8h",
        "报警阈值": "低报警：设定值-10%；高报警：设定值+10%",
        "常见故障": "法拉第杯污染、积分器漂移、束流波动",
        "维护周期": "法拉第杯清洁：每周；校准：每月",
        "相关标准": "SEMI E10, SEMI E79",
        "备注": "束流强度与注入剂量直接相关，剂量=束流×时间/扫描面积"
      }
    },
